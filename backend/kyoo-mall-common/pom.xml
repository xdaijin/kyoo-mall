<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kyoo</groupId>
        <artifactId>kyoo-mall-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>kyoo-mall-common</artifactId>
    <name>kyoo-mall-common</name>
    <description>共享内核：统一响应、业务异常、审计字段基类。保持零 Spring 依赖，任何模块/服务都可复用。</description>

    <dependencies>
        <!-- 仅 MP 注解（@TableField 等被动元数据），不引入完整 MyBatis-Plus，保持零 Spring 依赖 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
